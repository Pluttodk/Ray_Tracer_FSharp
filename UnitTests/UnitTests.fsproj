<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <RootNamespace>TDD</RootNamespace>
    <AssemblyName>TDD</AssemblyName>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="AssemblyInfo.fs" />
    <Compile Include="Assert.fs" />
    <Compile Include="TransformationTest.fs" />
    <Compile Include="BVH/BVHTest.fs" />
    <Compile Include="RG/RegularGridsTest.fs" />
    <Compile Include="ImplicitSurfaces/ExprParseTests.fs" />
    <Compile Include="ImplicitSurfaces/ExprToPolyTests.fs" />
    <Compile Include="ImplicitSurfaces/ExprToPolyTests2.fs" />
    <Compile Include="ImplicitSurfaces/PolyToUnipolyTests.fs" />
    <Compile Include="ImplicitSurfaces/ImplicitSurfacesTests.fs" />
    <Compile Include="SamplingTest.fs" />
    <Compile Include="BsdfTests.fs" />
    <Compile Include="PathTransportTests.fs" />
    <Compile Include="SkyTests.fs" />
    <Compile Include="ShapeTest.fs" />
    <Compile Include="ImageIOTests.fs" />
    <Compile Include="AccelerationRegressionTests.fs" />
    <Compile Include="LightingRegressionTests.fs" />
    <Compile Include="GeometryRegressionTests.fs" />
    <Compile Include="MeshRegressionTests.fs" />
    <Compile Include="NumericalRegressionTests.fs" />
    <Compile Include="MotionTests.fs" />
    <Compile Include="AnimationTests.fs" />
    <Compile Include="PhysicsTests.fs" />
    <Compile Include="GltfTests.fs" />
    <Compile Include="FilmTests.fs" />
    <Compile Include="Program.fs" />
  </ItemGroup>
  <ItemGroup>
    <None Include="fixtures/**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../RayTracer/RayTracer.fsproj" />
    <ProjectReference Include="../RayTracer.Animation/RayTracer.Animation.fsproj" />
    <ProjectReference Include="../RayTracer.ImageIO/RayTracer.ImageIO.fsproj" />
  </ItemGroup>
</Project>
