<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <!-- F# optimized continuations introduce Unit/ldnull helpers rejected by ILGPU. -->
    <Optimize>false</Optimize>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../SceneFormat/SceneFormat.fsproj" />
    <ProjectReference Include="../RayTracer/RayTracer.fsproj" />
    <ProjectReference Include="../RayTracer.ImageIO/RayTracer.ImageIO.fsproj" />
    <PackageReference Include="ILGPU" Version="[1.5.3]" />
    <PackageReference Include="ILGPU.Algorithms" Version="[1.5.3]" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="DeviceTypes.fs" />
    <Compile Include="DeviceMath.fs" />
    <Compile Include="DeviceGeometry.fs" />
    <Compile Include="DeviceTransport.fs" />
    <Compile Include="DeviceKernels.fs" />
    <Compile Include="CudaRuntime.fs" />
    <Compile Include="CudaRenderer.fs" />
    <Compile Include="HostScene.fs" />
    <Compile Include="GeometryTests.fs" />
    <Compile Include="SelfTests.fs" />
    <Compile Include="CoreComparison.fs" />
    <Compile Include="Gate.fs" />
    <Compile Include="../BenchmarkRunner/LinearOutput.fs" Link="LinearOutput.fs" />
    <Compile Include="Worker.fs" />
    <Compile Include="Program.fs" />
  </ItemGroup>
</Project>
