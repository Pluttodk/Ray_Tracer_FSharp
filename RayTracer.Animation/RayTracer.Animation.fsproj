<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Tracer.Animation</RootNamespace>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Easing.fs" />
    <Compile Include="Tracks.fs" />
    <Compile Include="SceneGraph.fs" />
    <Compile Include="Physics.fs" />
    <Compile Include="Bake.fs" />
    <Compile Include="Terrain.fs" />
    <Compile Include="Stage.fs" />
    <Compile Include="Demos.fs" />
    <Compile Include="Gltf.fs" />
    <Compile Include="Audio.fs" />
    <Compile Include="Particles.fs" />
    <Compile Include="Knight.fs" />
    <Compile Include="Sponza.fs" />
    <Compile Include="Film.fs" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../RayTracer/RayTracer.fsproj" />
    <ProjectReference Include="../RayTracer.ImageIO/RayTracer.ImageIO.fsproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="SharpGLTF.Toolkit" Version="1.0.7" />
  </ItemGroup>
</Project>
