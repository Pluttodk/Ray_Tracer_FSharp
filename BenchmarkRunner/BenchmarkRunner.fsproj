<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>BenchmarkRunner</AssemblyName>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../SceneFormat/SceneFormat.fsproj" />
    <ProjectReference Include="../RayTracer.ImageIO/RayTracer.ImageIO.fsproj" />
    <ProjectReference Include="../RayTracer/RayTracer.fsproj" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="ScenePolicy.fs" />
    <Compile Include="SceneBuilder.fs" />
    <Compile Include="LinearOutput.fs" />
    <Compile Include="Worker.fs" />
    <Compile Include="Program.fs" />
  </ItemGroup>
</Project>
